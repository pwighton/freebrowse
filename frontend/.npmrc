# Symlink (do not copy) local `file:` dependencies so a rebuild of the linked
# package — currently @niivue/niivue -> ../../niivue-mono/packages/niivue
# (branch 20260928-volume-visible, the volume `visible` feature) — is reflected
# without reinstalling. Overrides a global `install-links=true`. Temporary: goes
# away with the registry pin once upstream releases the feature.
install-links=false
